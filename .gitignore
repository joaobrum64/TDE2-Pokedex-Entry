# ==========================================
# DATASET DE TREINAMENTO
# ==========================================

# Dataset pesado de imagens
datasets


# ==========================================
# MODELOS DE MACHINE LEARNING
# ==========================================

# Ignora os modelos treinados
modelos/*

# Permite manter a pasta modelos no Git
!modelos/.gitkeep

# Os dois modelos usados pela API vão para o Git, para o projeto rodar
# logo depois do clone (o detector é salvo em meia precisão para ficar
# abaixo do limite de 100 MB por arquivo do GitHub).
!modelos/pokemon_resnet18_v3.pth
!modelos/pokemon_object_detector.pth

# Arquivos compactados (ex.: cópias da pasta modelos)
*.zip


# ==========================================
# PYTHON
# ==========================================

# Ambiente virtual
.venv/
venv/
env/

# Cache do Python
__pycache__/
*.py[cod]
*.pyo

# Cache de ferramentas Python
.pytest_cache/
.mypy_cache/
.coverage


# ==========================================
# NODE / REACT
# ==========================================

node_modules/
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ==========================================
# VARIAVEIS DE AMBIENTE
# ==========================================

.env
.env.*
!.env.example


# ==========================================
# EDITORES / IDEs
# ==========================================

.vscode/
.idea/


# ==========================================
# SISTEMA OPERACIONAL
# ==========================================

.DS_Store
Thumbs.db
desktop.ini


# ==========================================
# ARQUIVOS TEMPORARIOS
